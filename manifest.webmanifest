{
  "id": "./",
  "name": "FARO — APP DO MOTORISTA!",
  "short_name": "FARO",
  "description": "FARO — APP DO MOTORISTA! Metas, custos, histórico e inteligência financeira para motoristas de aplicativo.",
  "start_url": "./app-shell.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "orientation": "portrait-primary",
  "lang": "pt-BR",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./faro-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "dir": "ltr",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "Registrar dia",
      "short_name": "Registrar",
      "description": "Lance os ganhos e gastos de hoje",
      "url": "./app-shell.html?atalho=registrar",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Início",
      "short_name": "Início",
      "description": "Veja a meta e o resultado de hoje",
      "url": "./app-shell.html?atalho=inicio",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot-home.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Meta de hoje e resultado da semana"
    },
    {
      "src": "./screenshot-register.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Registrar o dia em poucos toques"
    }
  ]
}
